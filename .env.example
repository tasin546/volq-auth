# ==============================================================================
# VOLQ-AUTH ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public Web and API Gateway Port (Auto-detected on Hidden Cloud / Pterodactyl)
PORT=3000

# Internal Go API Port (Used internally by Next.js proxy)
BACKEND_PORT=8080

# Cloud PostgreSQL Database (Aiven Managed PostgreSQL)
DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@volq-auth-volq-auth.j.aivencloud.com:16813/defaultdb?sslmode=require

# Security Keys
JWT_SECRET=volq_super_secret_jwt_key_32bytes_min!
SERVER_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Default Superadmin Initial Credentials
ADMIN_USER=admin
ADMIN_PASS=Admin1234!
ADMIN_EMAIL=admin@volq-auth.local

# Optional Cloudflare R2 Payload Storage (Free 10GB Tier)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=
R2_BUCKET_NAME=volq-auth-payloads
